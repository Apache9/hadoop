<configuration>
  <!-- Normal mode is test. To run just the commands and dump the output
       to the log, set it to nocompare -->
  <mode>test</mode>

  <!--  Comparator types:
           SubstringComparator
           SubstringComparator
           RegexpComparator
           TokenComparator
           -->
  <tests>
    <test>
      <description>Ttl : set and get ttl on a file</description>
      <test-commands>
        <command>-fs NAMENODE -touchz /file1</command>
        <command>-fs NAMENODE -setTtl 123456 /file1</command>
        <command>-fs NAMENODE -getTtl /file1</command>
      </test-commands>
      <cleanup-commands>
        <command>-fs NAMENODE -rm /file1</command>
      </cleanup-commands>
      <comparators>
        <comparator>
          <type>SubstringComparator</type>
          <expected-output>Effective TTL: 123456.</expected-output>
        </comparator>
      </comparators>
    </test>

    <test>
      <description>Ttl : set and get ttl on a file with sinceLastWrite</description>
      <test-commands>
        <command>-fs NAMENODE -touchz /file1</command>
        <command>-fs NAMENODE -setTtl -sinceLastWrite 123456 /file1</command>
        <command>-fs NAMENODE -getTtl /file1</command>
      </test-commands>
      <cleanup-commands>
        <command>-fs NAMENODE -rm /file1</command>
      </cleanup-commands>
      <comparators>
        <comparator>
          <type>SubstringComparator</type>
          <expected-output>Effective TTL: 123456. TTL will be applied from the last modification time.</expected-output>
       </comparator>
      </comparators>
    </test>

    <test>
